# ========================================================
# WhatToCook Environment Configuration
# Copy to .env and adjust. Used by docker compose AND bare-metal runs.
# ========================================================

# --- Runtime ------------------------------------------------------------
# DEBUG=true enables Django dev conveniences (incl. /media/ serving).
# Set DEBUG=false behind gunicorn in real deployments.
DEBUG=true
# SECRET_KEY: set a strong random value in production. A dev default exists.
# SECRET_KEY=change-me
# ALLOWED_HOSTS: comma-separated hosts. Default "*" (dev only).
# ALLOWED_HOSTS=localhost,127.0.0.1
# Extra CSRF-trusted origins (comma-separated) if you serve the SPA
# from a non-default origin.
# CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------
# Docker compose sets USE_POSTGRES/DB_HOST for you via environment.
#
# BARE-METAL DEV (no Docker): leave DB_HOST unset or set USE_POSTGRES=false
# to force SQLite (db.sqlite3). If DB_HOST is set, Postgres is required.
USE_POSTGRES=
DB_HOST=

# PostgreSQL credentials (used by the db container and Django)
POSTGRES_USER=whattocook
POSTGRES_PASSWORD=secret
POSTGRES_DB=whattocook
DB_PORT=5432

# --- AI Provider: "gemini" or "lmstudio" (default: gemini) --------------
AI_PROVIDER=gemini

# Google AI Studio Gemini API Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Local LM Studio Configuration (Alternative / Offline LLM)
LMSTUDIO_URL=http://host.docker.internal:1234/v1/chat/completions
MODEL_NAME=llama-3.2-3b-instruct

# --- Celery: RabbitMQ (broker) + Redis (results & cache) ----------------
# RabbitMQ carries the Celery task queue; Redis stores task results and
# backs the Django cache. Docker compose builds the in-network URLs for you
# from the RabbitMQ credentials below (they override anything set here).
# Special characters in the password must be URL-encoded inside the URL.
RABBITMQ_DEFAULT_USER=whattocook
RABBITMQ_DEFAULT_PASS=secret
# BARE-METAL DEV (no Docker): run RabbitMQ + Redis locally (guest/guest works
# from localhost) and either keep the defaults or set explicitly:
# CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5672//
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Django cache backend: a redis URL enables Redis caching (compose sets this).
# Leave empty for in-process memory cache (fine for local dev).
REDIS_URL=

# --- Telegram Bot -------------------------------------------------------
# Create a bot with @BotFather on Telegram and paste credentials below:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=WhatToCookChefBot
