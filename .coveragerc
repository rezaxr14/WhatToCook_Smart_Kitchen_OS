[run]
source = GetFood, WhatToCook
omit =
    */migrations/*
    GetFood/tests.py
    GetFood/management/commands/seed_*

[report]
# Ratchet: raise this as coverage improves (measured 94% on 2026-10-19 on SQLite; weakest: WhatToCook/settings.py and
# GetFood/utils.py, both < 75%, plus the wsgi/asgi entry points that tests never import).
fail_under = 92
skip_empty = True
show_missing = False
