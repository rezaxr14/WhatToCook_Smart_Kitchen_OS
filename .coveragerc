[run]
source = GetFood, WhatToCook
omit =
    */migrations/*
    GetFood/tests.py
    GetFood/management/commands/seed_*

[report]
# Ratchet: raise this as coverage improves (measured 93% on 2026-10-16 on SQLite; weakest: WhatToCook/settings.py,
# GetFood/utils.py and GetFood/tasks.py, all < 85%).
fail_under = 90
skip_empty = True
show_missing = False
